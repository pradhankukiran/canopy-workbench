# ------------------------------
# Local development infrastructure
# ------------------------------

# PostgreSQL
POSTGRES_DB=canopy
POSTGRES_USER=canopy
POSTGRES_PASSWORD=canopy_dev_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEFAULT_BUCKET=canopy-dev

# ------------------------------
# Common application/service endpoints
# ------------------------------
DATABASE_URL=postgresql://canopy:canopy_dev_password@localhost:5432/canopy
REDIS_URL=redis://localhost:6379/0
CANOPY_UPLOAD_DIR=/home/kiran/canopy-workbench/target/uploads
API_HOST=0.0.0.0
API_PORT=3001
WORKER_PORT=4001
WORKER_CONCURRENCY=2
WORKER_STEP_DELAY_MS=350
# Optional: real Property-Cat Pricing YLT Scala engine handoff (supports "{input}" placeholder)
WORKER_PROPERTY_PRICING_SCALA_CLI_COMMAND=sbt -batch -error "canopy-engine-property/runMain canopy.engine.property.Hurdat2PropertyCatPricingYltCli --input {input}"
WORKER_PROPERTY_PRICING_SCALA_CLI_CWD=/home/kiran/canopy-workbench
WORKER_PROPERTY_PRICING_SCALA_CLI_TIMEOUT_MS=120000
# Optional: real ILS HURDAT2 Scala engine handoff (supports "{input}" placeholder)
WORKER_ILS_SCALA_CLI_COMMAND=sbt -batch -error "canopy-engine-trigger/runMain canopy.engine.trigger.Hurdat2IlsTriggerCli --input {input}"
WORKER_ILS_SCALA_CLI_CWD=/home/kiran/canopy-workbench
WORKER_ILS_SCALA_CLI_TIMEOUT_MS=120000
# Optional: real MPI Scala engine handoff (supports "{input}" placeholder)
WORKER_MPI_SCALA_CLI_COMMAND=sbt -batch -error "canopy-engine-portfolio/runMain canopy.engine.portfolio.MarginalPortfolioImpactCli --input {input}"
WORKER_MPI_SCALA_CLI_CWD=/home/kiran/canopy-workbench
WORKER_MPI_SCALA_CLI_TIMEOUT_MS=120000
CANOPY_REDIS_PREFIX=canopy:phase1
CANOPY_RUN_QUEUE=canopy_phase1_runs
VITE_API_BASE_URL=http://localhost:3001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET=canopy-dev
