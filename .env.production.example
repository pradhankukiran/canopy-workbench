# -------------------------------------------------------------------
# Production environment variables for docker-compose.prod.yml
#
# Copy to .env.production and fill in real secrets:
#   cp .env.production.example .env.production
#
# NEVER commit .env.production — it is gitignored.
# -------------------------------------------------------------------

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_DB=canopy
POSTGRES_USER=canopy
POSTGRES_PASSWORD=CHANGE_ME_postgres_strong_password

# ── Redis ──────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_strong_password

# ── MinIO (S3-compatible) ──────────────────────────────────────
MINIO_ROOT_USER=canopy-minio-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_strong_password
S3_BUCKET=canopy-prod
S3_REGION=us-east-1

# ── Application ────────────────────────────────────────────────
CANOPY_REDIS_PREFIX=canopy:phase1
CANOPY_RUN_QUEUE=canopy_phase1_runs
WORKER_CONCURRENCY=2
WORKER_STEP_DELAY_MS=350
