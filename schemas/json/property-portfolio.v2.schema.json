{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canopy.workbench/contracts/json/v2/property-portfolio.schema.json",
  "title": "PropertyPortfolio",
  "description": "Property exposure dataset. v2 adds construction, code-era, occupancy taxonomy, per-peril deductibles and sublimits. All v2-only fields are optional so v1 payloads remain valid; missing fields are filled by enrichPortfolio() defaults (keyed on country/region) and emitted in the run's enrichmentLog.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["v1", "v2"],
      "description": "Optional explicit version tag. Absent = treat as v1-compatible."
    },
    "portfolioId": {
      "type": "string",
      "pattern": "^pf_[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "asOfDate": {
      "type": "string",
      "format": "date"
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "locationId": {
            "type": "string",
            "pattern": "^loc_[a-z0-9_]+$"
          },
          "country": {
            "type": "string",
            "minLength": 2
          },
          "region": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "perilSet": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tiv": {
            "type": "number",
            "minimum": 0
          },
          "deductible": {
            "type": "number",
            "minimum": 0,
            "description": "Site-level deductible applied to ground-up loss. When perilDeductibles are specified, the per-peril value takes precedence."
          },
          "limit": {
            "type": "number",
            "minimum": 0
          },
          "occupancy": {
            "type": "string",
            "description": "Free-form legacy field (v1). For v2, prefer occupancyClass."
          },
          "occupancyClass": {
            "type": "string",
            "enum": [
              "residential_single_family",
              "residential_multi_family",
              "commercial_retail",
              "commercial_office",
              "industrial_light",
              "industrial_heavy",
              "hospitality",
              "healthcare",
              "education",
              "government",
              "agricultural",
              "warehouse",
              "other"
            ],
            "description": "Hazus-aligned occupancy taxonomy. See canopy-data/vulnerability/PROVENANCE.md."
          },
          "constructionClass": {
            "type": "string",
            "enum": [
              "wood_frame",
              "masonry_unreinforced",
              "masonry_reinforced",
              "reinforced_concrete",
              "steel_frame",
              "manufactured_home",
              "mixed",
              "other"
            ],
            "description": "Structural system. Drives vulnerability curve lookup."
          },
          "yearBuilt": {
            "type": "integer",
            "minimum": 1800,
            "maximum": 2100
          },
          "numberOfStories": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "codeEra": {
            "type": "string",
            "enum": [
              "pre_code",
              "legacy_code",
              "moderate_code",
              "modern_code",
              "high_code"
            ],
            "description": "Building-code regime at construction/retrofit. Hazus buckets."
          },
          "roofShape": {
            "type": "string",
            "enum": [
              "gable",
              "hip",
              "flat",
              "complex",
              "unknown"
            ]
          },
          "roofCover": {
            "type": "string",
            "enum": [
              "asphalt_shingle",
              "clay_tile",
              "concrete_tile",
              "metal",
              "membrane",
              "built_up",
              "unknown"
            ]
          },
          "surfaceRoughnessClass": {
            "type": "string",
            "enum": [
              "open_water",
              "open_terrain",
              "suburban",
              "urban",
              "dense_urban",
              "forest"
            ]
          },
          "perilDeductibles": {
            "type": "object",
            "description": "Per-peril deductible overrides. Keys are peril codes (WIND, SURGE, FLOOD, ...). Values are absolute amounts in the portfolio currency; fractional values in (0,1] are treated as a percentage of TIV.",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "sublimits": {
            "type": "object",
            "description": "Per-peril sublimits layered on top of the site limit. Same semantics as perilDeductibles for absolute vs fractional values.",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "required": [
          "locationId",
          "country",
          "perilSet",
          "tiv"
        ]
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    }
  },
  "required": [
    "portfolioId",
    "name",
    "currency",
    "locations"
  ]
}
