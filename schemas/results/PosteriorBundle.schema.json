{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canopy.workbench/contracts/results/v1/PosteriorBundle.schema.json",
  "title": "PosteriorBundle",
  "description": "Posterior outputs and summary metrics generated by a run.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^run_[a-z0-9]+$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^ws_[a-z0-9]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "modelVersion": {
      "type": "string"
    },
    "priorVersion": {
      "type": "string"
    },
    "posteriorSampleCount": {
      "type": "integer",
      "minimum": 1
    },
    "riskMetrics": {
      "$ref": "./RiskMetrics.schema.json"
    },
    "yearOutcomes": {
      "type": "array",
      "items": {
        "$ref": "./YearOutcome.schema.json"
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rHatMax": {
          "type": "number",
          "minimum": 0
        },
        "essMin": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summaryUri": {
          "type": "string",
          "format": "uri"
        },
        "rawSamplesUri": {
          "type": "string",
          "format": "uri"
        },
        "traceUri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "moduleOutputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "marginalPortfolioImpact": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "baselinePortfolioId": {
              "type": "string",
              "pattern": "^pf_[a-z0-9]+$"
            },
            "candidateDealName": {
              "type": "string"
            },
            "candidateDealLimit": {
              "type": "number",
              "minimum": 0
            },
            "tailSelection": {
              "$ref": "#/$defs/MarginalPortfolioImpactTailSelection"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "tailMetric": {
              "type": "string"
            },
            "comparisonRows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MarginalPortfolioImpactComparisonRow"
              }
            },
            "tailRiskComparison": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MarginalPortfolioImpactComparisonRow"
              }
            },
            "beforeAfterTailRisk": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MarginalPortfolioImpactComparisonRow"
              }
            },
            "beforeMetricsTable": {
              "$ref": "#/$defs/MarginalPortfolioImpactMetricsTable"
            },
            "afterMetricsTable": {
              "$ref": "#/$defs/MarginalPortfolioImpactMetricsTable"
            },
            "changeMetricsTable": {
              "$ref": "#/$defs/MarginalPortfolioImpactMetricsTable"
            }
          },
          "required": []
        },
        "propertyCatPricing": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "simulatedYears": {
              "type": "integer",
              "minimum": 1
            },
            "yltRows": {
              "type": "array"
            },
            "yearLossTable": {
              "type": "array"
            },
            "pricingSummaryTable": {
              "$ref": "#/$defs/ModuleOutputSummaryTable"
            },
            "yltSummaryTable": {
              "$ref": "#/$defs/PropertyCatPricingYltSummaryTable"
            }
          },
          "required": []
        },
        "ilsParametricTrigger": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "triggerMetric": {
              "type": "string"
            },
            "annualTriggerProbability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "triggerSimulation": {
              "type": "array"
            },
            "triggerSummaryTable": {
              "$ref": "#/$defs/IlsParametricTriggerSummaryTable"
            }
          },
          "required": []
        }
      }
    }
  },
  "required": [
    "runId",
    "generatedAt",
    "posteriorSampleCount",
    "riskMetrics"
  ],
  "$defs": {
    "MarginalPortfolioImpactTailSelection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "curve": {
          "type": "string",
          "enum": [
            "oep",
            "aep"
          ]
        },
        "metric": {
          "type": "string",
          "enum": [
            "var",
            "tvar"
          ]
        },
        "returnPeriodYears": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "curve",
        "metric",
        "returnPeriodYears"
      ]
    },
    "MarginalPortfolioImpactMetricsTable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tableId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MarginalPortfolioImpactMetricsColumn"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MarginalPortfolioImpactMetricsRow"
          }
        }
      },
      "required": [
        "columns",
        "rows"
      ]
    },
    "MarginalPortfolioImpactMetricsColumn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string"
        },
        "format": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "label"
      ]
    },
    "MarginalPortfolioImpactMetricsRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metricKey": {
          "type": "string",
          "minLength": 1
        },
        "metricLabel": {
          "type": "string"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          }
        }
      },
      "required": [
        "metricKey",
        "values"
      ]
    },
    "MarginalPortfolioImpactComparisonRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "returnPeriodYears": {
          "type": "integer",
          "minimum": 1
        },
        "metric": {
          "type": "string"
        },
        "before": {
          "type": "number"
        },
        "after": {
          "type": "number"
        },
        "delta": {
          "type": "number"
        },
        "deltaPct": {
          "type": "number"
        }
      },
      "required": [
        "returnPeriodYears"
      ]
    },
    "ModuleOutputSummaryTable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tableId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModuleOutputSummaryColumn"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModuleOutputSummaryRow"
          }
        }
      },
      "required": [
        "columns",
        "rows"
      ]
    },
    "ModuleOutputSummaryColumn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string"
        },
        "format": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "label"
      ]
    },
    "ModuleOutputSummaryRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rowKey": {
          "type": "string",
          "minLength": 1
        },
        "rowLabel": {
          "type": "string"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          }
        }
      },
      "required": [
        "rowKey",
        "values"
      ]
    },
    "PropertyCatPricingYltSummaryTable": {
      "allOf": [
        {
          "$ref": "#/$defs/ModuleOutputSummaryTable"
        }
      ],
      "description": "Tabular summary of yearly loss table (YLT) outputs for the property cat pricing module."
    },
    "IlsParametricTriggerSummaryTable": {
      "allOf": [
        {
          "$ref": "#/$defs/ModuleOutputSummaryTable"
        }
      ],
      "description": "Tabular trigger summary outputs for the ILS parametric trigger module."
    }
  }
}
