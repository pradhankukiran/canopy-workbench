{
  "name": "canopy-workbench",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @canopy/web dev",
    "dev:api": "pnpm --filter @canopy/api dev",
    "dev:worker": "pnpm --filter @canopy/worker dev",
    "dev:scheduler": "pnpm --filter @canopy/scheduler dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --no-bail test"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
